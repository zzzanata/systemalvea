generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Valores em dinheiro: Decimal(12, 2). Datas de calendário (vencimento, nascimento)
// ficam ao meio-dia UTC (ver lib/dates.ts); horários de consulta são DateTime normais.

// ---------- Usuários e histórico ----------

// Os dois perfis têm acesso total; o perfil só identifica quem é quem.
enum Role {
  DENTIST
  RECEPTION
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RECEPTION)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  auditLogs AuditLog[]
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// Histórico de alterações: toda gravação feita pelo sistema deixa uma linha aqui.
// userName e entityLabel são cópias (continuam legíveis mesmo se o registro for apagado).
model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  userName    String
  action      AuditAction
  entity      String // "patient", "appointment", "budget", "receivable"...
  entityId    String
  entityLabel String // ex.: nome do paciente, "Orçamento #12"
  summary     String // frase pronta para a tela
  // Campos alterados: { campo: { from, to } } (valores já formatados para leitura).
  changes     Json?
  createdAt   DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

// ---------- Pacientes e procedimentos ----------

model Patient {
  id        String    @id @default(cuid())
  name      String
  cpf       String?   @unique
  phone     String?
  email     String?
  birthDate DateTime?
  address   String?
  notes     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  appointments Appointment[]
  budgets      Budget[]
  receivables  Receivable[]

  @@index([name])
}

// Tabela de preços da clínica.
model Procedure {
  id          String   @id @default(cuid())
  name        String   @unique
  price       Decimal  @default(0) @db.Decimal(12, 2)
  durationMin Int      @default(30)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
  budgetItems  BudgetItem[]
}

// ---------- Agenda ----------

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  DONE
  NO_SHOW
  CANCELED
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  procedureId String?
  startsAt    DateTime
  endsAt      DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  procedure Procedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([patientId])
}

// Horário bloqueado na agenda (almoço, folga, feriado, curso...).
model ScheduleBlock {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String
  createdAt DateTime @default(now())

  @@index([startsAt])
}

// ---------- Orçamentos ----------

enum BudgetStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

model Budget {
  id         String       @id @default(cuid())
  number     Int          @unique @default(autoincrement())
  patientId  String
  status     BudgetStatus @default(DRAFT)
  discount   Decimal      @default(0) @db.Decimal(12, 2)
  validUntil DateTime?
  notes      String?
  approvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items       BudgetItem[]
  receivables Receivable[]

  @@index([patientId])
  @@index([status])
}

model BudgetItem {
  id          String  @id @default(cuid())
  budgetId    String
  procedureId String?
  description String
  tooth       String? // dente ou região (ex.: "36", "arcada superior")
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  position    Int     @default(0)

  budget    Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  procedure Procedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)

  @@index([budgetId, position])
}

// ---------- Financeiro (particular) ----------

enum PaymentMethod {
  PIX
  CASH
  DEBIT
  CREDIT
  BOLETO
  TRANSFER
}

// Situação gravada. "Vencida" é calculada na tela (aberta e com vencimento passado);
// "parcialmente paga" também (soma dos pagamentos menor que o valor).
enum BillStatus {
  OPEN
  PAID
  CANCELED
}

// Conta a receber: uma parcela de um tratamento/orçamento ou uma cobrança avulsa.
model Receivable {
  id           String     @id @default(cuid())
  patientId    String?
  budgetId     String?
  description  String
  installment  Int        @default(1) // número da parcela
  installments Int        @default(1) // total de parcelas
  amount       Decimal    @db.Decimal(12, 2)
  dueDate      DateTime
  status       BillStatus @default(OPEN)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  patient  Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  budget   Budget?   @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([status, dueDate])
  @@index([patientId])
  @@index([budgetId])
}

// Recebimento (pode haver vários por parcela: pagamento parcial).
model Payment {
  id           String        @id @default(cuid())
  receivableId String
  amount       Decimal       @db.Decimal(12, 2)
  paidAt       DateTime
  method       PaymentMethod
  // Taxa da maquininha/banco descontada (opcional): o líquido é amount - fee.
  fee          Decimal       @default(0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime      @default(now())

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([paidAt])
  @@index([receivableId])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  expenses Expense[]
}

// Conta a pagar (despesa da clínica). Despesas mensais repetidas compartilham recurrenceId.
model Expense {
  id           String         @id @default(cuid())
  categoryId   String?
  description  String
  supplier     String?
  amount       Decimal        @db.Decimal(12, 2)
  dueDate      DateTime
  status       BillStatus     @default(OPEN)
  paidAt       DateTime?
  method       PaymentMethod?
  recurrenceId String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([categoryId])
  @@index([recurrenceId])
}
