generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Estoque ----------

enum Role {
  ADMIN
  OPERATOR
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now())

  movements    StockMovement[]
  tasksUpdated Task[]          @relation("TaskUpdatedBy")
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  categoryId   String?
  unit         String   @default("un")
  // Custo médio ponderado: recalculado a cada entrada com valor.
  costPrice    Decimal  @default(0) @db.Decimal(14, 4)
  salePrice    Decimal  @default(0) @db.Decimal(12, 2)
  minStock     Decimal  @default(0) @db.Decimal(12, 3)
  currentStock Decimal  @default(0) @db.Decimal(12, 3)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category  Category?       @relation(fields: [categoryId], references: [id])
  movements StockMovement[]

  @@index([name])
  @@index([categoryId])
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String
  userId    String
  type      MovementType
  quantity  Decimal      @db.Decimal(12, 3)
  reason    String?
  note      String?
  // Entrada: valor unitário pago. Saída/ajuste: custo médio no momento. Nulo nos lançamentos antigos.
  unitCost      Decimal?     @db.Decimal(14, 4)
  supplierId    String?
  invoiceNumber String?
  createdAt DateTime     @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([userId])
  @@index([supplierId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  movements StockMovement[]
}

// ---------- Obras (usinas) ----------

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  DONE
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum MemberRole {
  LEAD
  MEMBER
}

// Uma obra / usina.
model Project {
  id          String        @id @default(cuid())
  name        String
  location    String?
  powerKwp    Decimal?      @db.Decimal(12, 2)
  startDate   DateTime?
  expectedEnd DateTime?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())

  tasks    Task[]
  team     TeamMember[]
  entries  FinanceEntry[]
  invoices Invoice[]
}

// Item do checklist da obra. A etapa é só um nome de grupo (stage).
model Task {
  id          String     @id @default(cuid())
  projectId   String
  stage       String
  title       String
  status      TaskStatus @default(TODO)
  position    Int
  updatedAt   DateTime   @updatedAt
  updatedById String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([projectId, position])
}

// Quem trabalha na obra (não precisa ter login no sistema).
model TeamMember {
  id        String     @id @default(cuid())
  projectId String
  name      String
  role      MemberRole @default(MEMBER)
  jobTitle  String?
  createdAt DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ---------- Financeiro ----------

enum EntryType {
  REVENUE
  COST
}

// Status guardado. Na tela: PENDING/ISSUED = "Pendente" (vira "Vencido" sozinho
// quando passa do vencimento), PAID = "Pago", CANCELED = "Cancelada".
// ISSUED e o PENDING antigo ("a emitir") continuam existindo para não perder dados.
enum InvoiceStatus {
  PENDING
  ISSUED
  CANCELED
  PAID
}

enum InvoiceType {
  IN  // entrada: nota de compra recebida (a pagar)
  OUT // saída: nota emitida pela empresa (a receber)
}

// Faturamento (REVENUE) ou custo (COST).
model FinanceEntry {
  id          String    @id @default(cuid())
  projectId   String?
  type        EntryType
  amount      Decimal   @db.Decimal(14, 2)
  date        DateTime
  description String
  createdAt   DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([projectId])
}

model Invoice {
  id          String        @id @default(cuid())
  projectId   String?
  number      String?
  description String
  amount      Decimal       @db.Decimal(14, 2)
  status      InvoiceStatus @default(PENDING)
  dueDate     DateTime?
  issuedAt    DateTime?
  createdAt   DateTime      @default(now())

  type          InvoiceType @default(OUT)
  accessKey     String?     @unique
  paidAt        DateTime?
  senderName    String?
  senderCnpj    String?
  recipientName String?
  recipientCnpj String?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([projectId])
  @@index([type])
}
